<Page
    x:Class="XboxIptvSmarters.Views.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

    <Grid x:Name="MainGrid">
        
        <!-- Media Player (pieno schermo) -->
        <Grid x:Name="MediaPlayerGrid"
              VerticalAlignment="Center"
              HorizontalAlignment="Center"
              Background="Black"/>

        <!-- Thumbnail placeholder -->
        <Image x:Name="ThumbnailImage" 
               Stretch="UniformToFill"
               Opacity="0.3"
               Visibility="Collapsed"/>

        <!-- Status overlay -->
        <Border Background="#80000000"
                Padding="40"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="15">
                <ProgressBar x:Name="LoadingProgress" 
                             IsIndeterminate="True" 
                             Width="200" 
                             Height="6"
                             Visibility="Collapsed"/>
                <TextBlock x:Name="StatusText" 
                           Text="Caricamento..." 
                           FontSize="20"
                           Foreground="White"
                           TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Top Controls -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="30"
                    Spacing="20">
            <Button x:Name="BackButton" 
                    Content="⬅ INDIETRO" 
                    FontSize="16"
                    Height="60"
                    Width="180"
                    Click="BackButton_Click"
                    Background="#CC000000"
                    Foreground="White"/>
            
            <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                <TextBlock x:Name="MediaTitle" 
                           Text="Titolo..." 
                           FontSize="24"
                           Foreground="White"
                           MaxWidth="600"
                           TextWrapping="Wrap"/>
                
                <Border x:Name="LiveIndicator" 
                        Background="#CC0000" 
                        CornerRadius="8" 
                        Padding="15,8"
                        Visibility="Collapsed">
                    <TextBlock Text="● LIVE" 
                               FontSize="16"
                               Foreground="White"/>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Bottom Controls -->
        <Border Background="#CC000000"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal"
                        Padding="30,20"
                        Spacing="20">
                <Button x:Name="PlayPauseButton" 
                        Content="▶" 
                        FontSize="28"
                        Height="70"
                        Width="100"
                        Click="PlayPauseButton_Click"/>
                
                <TextBlock x:Name="PlayPauseIcon" 
                           Text="▶" 
                           FontSize="24"
                           Foreground="White"
                           VerticalAlignment="Center">
        
                <TextBlock x:Name="FullIcon" 
                           Text="" />
                
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <TextBlock x:Name="StatusText" 
                               Text="Ready" 
                               FontSize="16"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="•" 
                               FontSize="16"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" 
                               Text="v1.0" 
                               FontSize="14"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
