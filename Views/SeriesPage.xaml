<Page
    x:Class="XboxIptvSmarters.Views.SeriesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" 
                    Padding="20" 
                    Orientation="Horizontal"
                    Spacing="20">
            <TextBlock Text="📡 Serie TV" 
                       FontSize="32" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
            
            <ProgressBar x:Name="LoadingProgress" 
                         IsIndeterminate="True" 
                         Width="200" 
                         Height="4"
                         Visibility="Visible"/>
            
            <TextBlock x:Name="StatusText" 
                       Text="Caricamento..." 
                       FontSize="16"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource SystemAccentColor}"/>
            
            <Button x:Name="BackToList" 
                    Content="⬅ INDIETRO" 
                    FontSize="14"
                    Height="45"
                    Padding="20,8"
                    Click="BackToList_Click"
                    Visibility="Collapsed"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            
            <!-- Lista Serie -->
            <Border x:Name="SeriesListPanel"
                    Background="{ThemeResource SystemControlBackgroundChromeBrush}" 
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Elenco Serie TV" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>

                    <ListView x:Name="SeriesList" 
                              Tapped="SeriesListItemView_Tapped"
                              DoubleTapped="SeriesListItemView_DoubleTapped"
                              IsTabStop="True"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Padding="12">
                                    <Image x:Name="SeriesCover" 
                                           Source="{Binding Cover}"
                                           Width="100" 
                                           Height="140"
                                           Stretch="UniformToFill"
                                           Margin="0,0,15,0"/>
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="400"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="📺 " FontSize="14"/>
                                            <TextBlock Text="{Binding SeriesId}" 
                                                       FontSize="14"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- Detail Panel -->
            <Border x:Name="DetailsPanel"
                    Visibility="Collapsed"
                    Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                    Padding="30">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Cover -->
                        <Border Grid.Column="0" 
                                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" 
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,20,0">
                            <Image x:Name="SeriesCover" 
                                   Stretch="UniformToFill"/>
                        </Border>

                        <!-- Details -->
                        <StackPanel Grid.Column="1" 
                                    Grid.RowSpan="2"
                                    Spacing="15">
                            <TextBlock x:Name="SeriesDetailsTitle" 
                                       FontSize="28" 
                                       FontWeight="Bold"/>
                            
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <TextBlock Text="Stagioni:" FontSize="16"/>
                                <TextBlock x:Name="SeasonsCountText" FontSize="16"/>
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <TextBlock Text="📚 Descrizione:" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="EpisodeDescription" 
                                       FontSize="14"
                                       TextWrapping="Wrap"/>

                            <!-- Seasons List -->
                            <TextBlock Text="Seleziona Stagione" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,0"/>
                            
                            <ComboBox x:Name="SeasonList" 
                                      Height="55"
                                      FontSize="16"
                                      SelectionChanged="Season_SelectionChanged"
                                      MinWidth="200"/>
                            
                            <!-- Episodes List -->
                            <TextBlock Text="Episodi" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       Margin="0,10,0,0"/>
                            
                            <ListView x:Name="EpisodeList" 
                                      Tapped="EpisodeItemView_Tapped"
                                      DoubleTapped="EpisodeItemView_DoubleTapped"
                                      Height="300"
                                      SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Padding="12">
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                                <TextBlock Text="{Binding EpisodeNumber}" 
                                                           FontSize="18"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="EPI." 
                                                           FontSize="10"
                                                           Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}"/>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="16"
                                                           FontWeight="SemiBold"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="⏱ " FontSize="12"/>
                                                    <TextBlock Text="{Binding DurationSec}" 
                                                               FontSize="12"/>
                                                    <TextBlock Text=" secondi"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <StackPanel>
                                <TextBlock x:Name="EpisodeTitle" 
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Margin="0,10,0,5"/>
                                <Button Content="▶ RIPRODUCI EPISODIO" 
                                        FontSize="16"
                                        Height="60"
                                        MinWidth="250"
                                        Click="EpisodeItemView_Tapped"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Footer -->
        <Border Grid.Row="2" 
                Background="{ThemeResource SystemControlBackgroundChromeBrush}" 
                Padding="20"
                BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="15">
                <TextBlock Text="💡 Seleziona una serie per vedere gli episodi" 
                           FontSize="14"
                           Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}"/>
                <TextBlock Text="•" 
                           FontSize="14"/>
                <TextBlock Text="Doppio tap per riprodurre" 
                           FontSize="14"
                           Foreground="{ThemeResource SystemControlDisabledBaseMediumLowBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
