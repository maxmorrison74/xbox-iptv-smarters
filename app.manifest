<?xml version="1.0" encoding="utf-8"?>
<asmv1:assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1" xmlns:asmv1="urn:schemas-microsoft-com:asm.v1" xmlns:asmv2="urn:schemas-microsoft-com:asm.v2" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <assemblyIdentity version="1.0.0.0" name="XboxIptvSmarters.manifest"/>
  <asmv2:application>
    <asmv2:windowsApp xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10">
      <Identity Name="XboxIptvSmarters" Publisher="CN=User" Version="1.0.0.0"/>
      <Properties>
        <DisplayName>IPTV Smarters Xbox</DisplayName>
        <PublisherDisplayName>User</PublisherDisplayName>
        <Logo>Assets\StoreLogo.png</Logo>
      </Properties>
      <Resources>
        <Resource Language="x-generate"/>
      </Resources>
      <Dependencies>
        <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersion="10.0.19041.0"/>
      </Dependencies>
      <Capabilities>
        <Capability Name="internetClient"/>
        <Capability Name="internetClientServer"/>
        <Capability Name="networkClientServer"/>
      </Capabilities>
    </asmv2:windowsApp>
  </asmv2:application>
</asmv1:assembly>
